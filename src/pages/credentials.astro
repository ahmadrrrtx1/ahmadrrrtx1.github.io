---
import Layout from "../layouts/base.astro";
import Panel from "../components/panel.astro";
import Chip from "../components/chip.astro";
import creds from "../data/credentials.json";
const kinds: Record<string, [string, string]> = { ASSESSED: ["ok", "✔"], "PROCTORED-EXAM": ["ok", "✔"], LAB: ["cyan", "◆"], "SKILL-BADGE": ["cyan", "◆"], "CANDIDATE": ["warn", "◔"], FOUNDATIONAL: ["", "○"], LITERACY: ["", "○"] };
---
<Layout title="~/credentials — certificates that measured something · Muhammad Ahmad" desc="Eight credentials worth linking, each with what it actually assessed — and the honest label for what it is." path="~/credentials">
  <div style="max-width:980px;margin:0 auto">
    <Panel h1="Selected credentials, verified" cmd="ls ~/credentials" tail={`${creds.verified.length} listed · not 37`}>
      <p class="lead" style="max-width:70ch">A ledger, not a wall. I've completed 37+ courses across ten
     -plus platforms — and a certificate only earns a row here if an actual mechanism measured something:
      a lab assessment, a graded sub-course sequence, a proctored exam. Below each row states, in my words,
      what it tested and what it doesn't entitle me to claim.</p>
      <div style="margin-top:16px">
        {creds.verified.map((c) => {
          const [tone, glyph] = kinds[c.kind] ?? ["", "·"];
          return <div class="row" style="grid-template-columns:1fr auto">
            <span class="r-body">
              <span class="r-title"><a class="tlink" href={c.url} rel="noopener">{c.name} ↗</a></span>
              <span class="r-oneline">{c.assesses}</span>
              <span class="meta">{c.issuer} · {c.date}</span>
            </span>
            <span class="r-right"><Chip status={c.kind.toLowerCase()} tone={tone} glyph={glyph} /></span>
          </div>;
        })}
      </div>
      <div class="callout" style="margin-top:16px"><p class="meta" style="line-height:1.7">{creds.aggregateNote}</p></div>
    </Panel>
  </div>
</Layout>
